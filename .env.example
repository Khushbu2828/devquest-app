# Copy to .env.local and adjust. Restart `npm run web` / `npm start` after changing.
# Only EXPO_PUBLIC_* values reach the app, and they are visible to anyone who has it. Never put secrets here.

# Where the app finds the DevQuest server (`npm run server`): AI quizzes, tutor, hints, reports.
# On a phone, use your computer's LAN IP instead of localhost, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_AI_SERVER_URL=http://localhost:8787

# Accounts and sync (optional). From your Supabase project: Project Settings → API.
# The publishable key is meant to ship in apps; row-level security (supabase/schema.sql) protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
