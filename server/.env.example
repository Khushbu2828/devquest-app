# Copy to server/.env (never committed). Read only by `npm run server`; nothing here reaches the app.

# Set ONE of these. Gemini is used when GEMINI_API_KEY is set, otherwise Claude.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# DEVQUEST_AI_PROVIDER=gemini         # or anthropic, to choose when both keys are set
# DEVQUEST_MODEL=gemini-3.8-flash     # default for Gemini; claude-opus-5-5 for Claude
# DEVQUEST_GEMINI_FALLBACKS=gemini-3.5-flash-lite

# Review queue at /admin (12+ characters). Leave empty to disable admin.
# DEVQUEST_ADMIN_TOKEN=
# DEVQUEST_REVIEW_NEW=false           # true: new AI questions wait for approval before learners see them
# DEVQUEST_REPORTS_TO_HIDE=2          # open reports that take an AI question out of rotation

# Cost limits per device per hour
# DEVQUEST_GENERATIONS_PER_HOUR=20
# DEVQUEST_ASSISTS_PER_HOUR=60

# PORT=8787
# DEVQUEST_ALLOWED_ORIGIN=*           # set to your web app's origin in production
